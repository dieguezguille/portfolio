{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "guillermodieguez",
  "main": "src/agents/worker.ts",
  "compatibility_date": "2026-09-25",
  "workers_dev": false,
  "preview_urls": true,
  "routes": [{ "pattern": "guillermodieguez.com", "custom_domain": true }],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/*", "!/_astro/*", "!/og/*"],
  },
}
