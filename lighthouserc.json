{
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "numberOfRuns": 3,
      "url": [
        "http://localhost/index.html",
        "http://localhost/es.html",
        "http://localhost/work/exa.html",
        "http://localhost/cv.html"
      ]
    },
    "assert": {
      "assertions": {
        "categories:accessibility": ["error", { "minScore": 1 }],
        "categories:best-practices": ["error", { "minScore": 1 }],
        "categories:performance": ["error", { "minScore": 0.95 }],
        "categories:seo": ["error", { "minScore": 1 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.02 }],
        "largest-contentful-paint": ["error", { "maxNumericValue": 1800 }],
        "resource-summary:document:size": ["error", { "maxNumericValue": 30720 }],
        "resource-summary:font:size": ["error", { "maxNumericValue": 92160 }],
        "resource-summary:script:size": ["error", { "maxNumericValue": 189440 }],
        "resource-summary:stylesheet:size": ["error", { "maxNumericValue": 20480 }],
        "resource-summary:total:size": ["error", { "maxNumericValue": 460800 }],
        "total-blocking-time": ["error", { "maxNumericValue": 100 }]
      }
    },
    "upload": { "target": "filesystem", "outputDir": ".lighthouseci" }
  }
}
