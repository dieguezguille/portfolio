---
import { getAbsoluteLocaleUrl, getRelativeLocaleUrl } from "astro:i18n";

import capabilities from "../capabilities/capabilities";
import kinds from "../contributions/kinds";
import when from "../contributions/when";
import jobs from "../experience/jobs";
import period from "../i18n/period";
import translations from "../i18n/translations";
import Layout from "../layouts/Layout.astro";
import profile from "../profile";
import studies from "../work/studies";
import facts from "./facts";
import summary from "./summary";

const t = translations(Astro.currentLocale);
const locale = Astro.currentLocale ?? "en";
const experience = await jobs(locale);
const entries = await studies(locale);
---

<Layout
  title={`CV — ${profile.name}`}
  description={t(
    "One-page CV of Guillermo Diéguez, head of frontend at Exa Labs, remote from Argentina: experience, capabilities, contributions, education and languages.",
  )}
>
  <article>
    <header>
      <h1>{profile.name}</h1>
      <p class="role">
        {t("Head of frontend at")} {profile.employer.name} <span>· {t("Remote from Argentina")}, UTC−3</span>
      </p>
      <ul class="contact" role="list">
        <li>
          <a href={`mailto:${profile.email}`}>{profile.email}</a>
        </li>
        {[profile.github, profile.linkedin].map((url) => (
          <li>
            <a href={url}>{url.replace(/^https:\/\/(?:www\.)?/, "")}</a>
          </li>
        ))}
        <li>
          <a href={getAbsoluteLocaleUrl(locale)}>{new URL(getAbsoluteLocaleUrl(locale)).host}</a>
        </li>
      </ul>
      <p class="summary">{summary(t, experience.at(-1)?.data.period.start)}</p>
      <a class="download label" href={getRelativeLocaleUrl(locale, "cv.pdf")} download="guillermo-dieguez-cv.pdf">
        {t("Download PDF")}
      </a>
    </header>

    <section aria-labelledby="experience">
      <h2 id="experience" class="label">
        {t("Experience")}
      </h2>
      {experience.map((job) => (
        <div class="entry">
          <h3>
            {job.data.role}, <span>{job.data.company}</span>
          </h3>
          <p class="when">{period(job.data.previous ? { start: job.data.previous.end } : job.data.period, locale)}</p>
          {job.data.previous && (
            <>
              <p class="previous">{job.data.previous.role}</p>
              <p class="when">{period({ start: job.data.period.start, end: job.data.previous.end }, locale)}</p>
            </>
          )}
          <ul class="what" role="list">
            {job.data.highlights.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
          {entries
            .filter((entry) => entry.data.job === job.id)
            .map((entry) => (
              <a class="case label" href={getAbsoluteLocaleUrl(locale, `work/${entry.slug}`)}>
                {t("Case study")}
              </a>
            ))}
        </div>
      ))}
    </section>

    <section aria-labelledby="freelance">
      <h2 id="freelance" class="label">
        {t("Freelance work")}
      </h2>
      {entries
        .filter((entry) => entry.data.job === undefined)
        .map((entry) => (
          <div class="entry">
            <h3>
              {entry.data.role}, <span>{entry.data.title}</span>
            </h3>
            <p class="when">{period(entry.data.period, locale)}</p>
            <ul class="what" role="list">
              {(entry.data.highlights ?? [entry.data.summary]).map((item) => (
                <li>{item}</li>
              ))}
            </ul>
            <a class="case label" href={getAbsoluteLocaleUrl(locale, `work/${entry.slug}`)}>
              {t("Case study")}
            </a>
          </div>
        ))}
    </section>

    <section aria-labelledby="capabilities">
      <h2 id="capabilities" class="label">
        {t("Capabilities")}
      </h2>
      <dl>
        {capabilities(t).map((group) => (
          <div>
            <dt>{group.name}</dt>
            <dd>{group.items.map((item) => item.name).join(", ")}</dd>
          </div>
        ))}
      </dl>
    </section>

    <section aria-labelledby="contributions">
      <h2 id="contributions" class="label">
        {t("Contributions")}
      </h2>
      <p class="inline">
        {profile.contributions
          .filter((contribution) => contribution.kind !== "issue")
          .map((contribution, index) => (
            <>
              {index > 0 && " · "}
              <a href={contribution.url}>{contribution.repo}</a> ({t(kinds[contribution.kind]).toLowerCase()},{" "}
              {when(contribution, t)})
            </>
          ))}
      </p>
    </section>

    {facts(t).map((group) => (
      <section aria-labelledby={group.id}>
        <h2 id={group.id} class="label">
          {group.name}
        </h2>
        <ul class:list={["facts", { flow: group.items.every((item) => !item.period) }]} role="list">
          {group.items.map((item) => (
            <li>
              <span>
                {item.name}
                {item.detail && <span class="muted"> · {item.detail}</span>}
              </span>
              {item.period && <span class="when">{item.period}</span>}
            </li>
          ))}
        </ul>
      </section>
    ))}
  </article>
</Layout>

<style>
  article {
    display: grid;
    gap: 2.5rem;
    max-width: 52rem;
    margin-inline: auto;
    padding: clamp(2rem, 1rem + 5vw, 5rem) var(--margin) var(--section);
  }

  header {
    display: grid;
    gap: 0.75rem;
  }

  h1 {
    font-size: var(--step-5);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1;
  }

  .role {
    font-size: var(--step-1);

    span {
      color: var(--muted);
      white-space: nowrap;
    }
  }

  .summary {
    max-width: 64ch;
    color: var(--muted);
  }

  .contact {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 1.25rem;
    color: var(--muted);
    font-family: var(--mono);
    font-size: var(--step--1);

    a {
      display: inline-flex;
      align-items: center;
      min-height: 32px;
    }
  }

  .download {
    display: inline-flex;
    align-items: center;
    justify-self: start;
    min-height: 44px;
    margin-top: 0.5rem;
    padding-inline: 1rem;
    border: 1px solid var(--line);
    border-radius: 2px;
    text-decoration: none;

    &:hover {
      border-color: var(--accent);
    }
  }

  section {
    display: grid;
    gap: 0.75rem;
  }

  h2 {
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--line);
    color: var(--muted);
  }

  .entry {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.15rem 1rem;
    padding-block: 0.35rem;
  }

  .facts li {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    padding-block: 0.35rem;
  }

  h3 {
    font-weight: 600;

    span {
      font-weight: 400;
    }
  }

  .when {
    justify-self: end;
    color: var(--muted);
    font-family: var(--mono);
    font-size: var(--step--1);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .what,
  .case {
    grid-column: 1 / -1;
  }

  .what {
    display: grid;
    gap: 0.25rem;
    margin-top: 0.25rem;
    padding-inline-start: 1.1em;
    list-style: square;

    li::marker {
      color: var(--accent);
    }
  }

  .case {
    display: inline-flex;
    align-items: center;
    justify-self: start;
    min-height: 32px;
  }

  .previous,
  .what,
  .inline,
  dd {
    color: var(--muted);
  }

  dl div {
    display: grid;
    grid-template-columns: 9rem 1fr;
    gap: 1rem;
  }

  a {
    text-decoration: underline;
    text-decoration-color: var(--line);
    text-underline-offset: 0.2em;

    &:hover {
      text-decoration-color: var(--accent);
    }
  }

  @media print {
    @page {
      margin: 0;
    }

    article {
      gap: 0.5rem;
      max-width: none;
      padding: 8mm 12mm;
      box-decoration-break: clone;
      font-size: 10pt;
      line-height: 1.2;
    }

    header {
      gap: 0.3rem;
    }

    section {
      gap: 0.25rem;
    }

    h1 {
      font-size: 22pt;
    }

    .role {
      font-size: 11.5pt;
    }

    .summary {
      max-width: none;
      margin-top: 0.15rem;
    }

    .contact {
      gap: 0 1.25em;
      font-size: 8.5pt;

      a {
        min-height: 0;
      }
    }

    h2 {
      padding-bottom: 0.15rem;
      border-color: #ccc;
      color: #000;
      font-family: var(--sans);
      font-size: 10pt;
      font-weight: 600;
      line-height: 1.2;
      letter-spacing: 0;
      text-transform: none;
    }

    .entry {
      grid-template-columns: auto 1fr auto;
      gap: 0 0.75em;
      padding-block: 0.1rem 0;
    }

    h3 {
      grid-column: 1;
    }

    .when {
      grid-column: 3;
      font-size: 9pt;
    }

    .previous {
      grid-column: 1 / 3;
    }

    .case {
      grid-row: 1;
      grid-column: 2;
      min-height: 0;
      font-size: 8.5pt;
      letter-spacing: 0;
      text-transform: none;
    }

    .facts li {
      padding: 0;
    }

    .flow {
      display: flex;
      flex-wrap: wrap;
      column-gap: 1.5em;
    }

    .what {
      gap: 0.05rem;
      margin-top: 0.1rem;

      li::marker {
        color: #999;
      }
    }

    dl div {
      grid-template-columns: 7rem 1fr;
    }

    .download {
      display: none;
    }

    .summary,
    .previous,
    .what,
    .when,
    .case,
    .inline,
    dd,
    .contact {
      color: #333;
    }

    .entry,
    section {
      break-inside: avoid;
    }
  }
</style>
