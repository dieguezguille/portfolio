---
import translations from "../i18n/translations";
import Arrow from "../layouts/Arrow.astro";
import profile from "../profile";
import build from "./build";

const t = translations(Astro.currentLocale);
---

<footer class="grid">
  <h2 class="label muted">{t("Colophon")}</h2>
  <dl class="label">
    <div>
      <dt class="muted">{t("Built with")}</dt>
      <dd>
        {[
          ["Astro", "https://github.com/withastro/astro"],
          ["three.js", "https://github.com/mrdoob/three.js"],
        ].map(([name, url], index) => (
          <>
            {index > 0 && ", "}
            <a class="link" href={url}>
              {name}
              <Arrow />
            </a>
          </>
        ))}
      </dd>
    </div>
    <div>
      <dt class="muted">Commit</dt>
      <dd>
        <a class="link" href={`${profile.source}/commit/${build.sha}`}>
          <code>{build.sha}</code>
          <Arrow />
        </a>
      </dd>
    </div>
  </dl>
  <p class="label muted copyright">
    © {build.date.getFullYear()} {profile.name}
  </p>
</footer>

<style>
  footer {
    row-gap: 1.5rem;
    padding-block: 3rem;
    border-top: 1px solid var(--line);
  }

  h2,
  dl,
  .copyright {
    grid-column: 1 / -1;
  }

  dl {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 2rem;

    div {
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }

    a {
      display: inline-flex;
      align-items: center;
      min-height: 24px;
    }
  }

  @media (width >= 64rem) {
    h2 {
      grid-column: 1 / 3;
    }

    dl,
    .copyright {
      grid-column: 3 / -1;
    }
  }

  @media print {
    footer {
      display: none;
    }
  }
</style>
