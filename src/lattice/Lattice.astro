---
import translations from "../i18n/translations";

const t = translations(Astro.currentLocale);
---

<div class="lattice" data-lattice>
  <svg class="fallback" viewBox="0 0 960 480" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
    <path
      class="edges"
      d="M0 240H960M300 240L340 150H560L600 240M480 240L520 330H760L800 240M520 150L560 60H960M840 240L880 330H960"
    ></path>
    <path
      class="nodes"
      d="M57 237h6v6h-6zM177 237h6v6h-6zM297 237h6v6h-6zM417 237h6v6h-6zM597 237h6v6h-6zM697 237h6v6h-6zM797 237h6v6h-6zM897 237h6v6h-6zM337 147h6v6h-6zM417 147h6v6h-6zM497 147h6v6h-6zM517 327h6v6h-6zM597 327h6v6h-6zM677 327h6v6h-6zM737 327h6v6h-6zM557 57h6v6h-6zM657 57h6v6h-6zM757 57h6v6h-6zM877 57h6v6h-6zM877 327h6v6h-6zM937 327h6v6h-6z"
    ></path>
    <path class="packets" d="M237 237h6v6h-6zM637 327h6v6h-6zM817 57h6v6h-6z"></path>
  </svg>
  <button class="pause label" type="button" hidden data-pause={t("Pause motion")} data-play={t("Resume motion")}>
    {t("Pause motion")}
  </button>
</div>

<script>
  const lattice = document.querySelector<HTMLElement>("[data-lattice]");
  const idle = (callback: () => void) =>
    "requestIdleCallback" in globalThis ? requestIdleCallback(callback, { timeout: 2000 }) : setTimeout(callback, 200);
  const start = () => {
    idle(() => {
      if (!lattice) return;
      const probe = new Worker(new URL("probe.ts", import.meta.url), { type: "module" });
      probe.addEventListener(
        "message",
        ({ data }: MessageEvent<boolean>) => {
          probe.terminate();
          if (!data) return;
          new IntersectionObserver((entries, observer) => {
            if (entries.every((entry) => !entry.isIntersecting)) return;
            observer.disconnect();
            void import("./mount").then(({ default: mount }) => mount(lattice));
          }).observe(lattice);
        },
        { once: true },
      );
    });
  };

  if (!(navigator as { connection?: { saveData?: boolean } }).connection?.saveData) {
    if (document.readyState === "complete") start();
    else addEventListener("load", start, { once: true });
  }
</script>

<style>
  .lattice {
    position: absolute;
    inset: 0;

    :global(canvas) {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      opacity: 0;
      pointer-events: none;
      transition: opacity var(--slow) var(--ease);
    }

    &[data-ready] :global(canvas) {
      opacity: 1;
    }

    &[data-ready] .fallback {
      opacity: 0;
    }
  }

  :global(.diagnostics) {
    position: fixed;
    bottom: var(--margin);
    left: var(--margin);
    z-index: 20;
    padding: 0.75rem 1rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-left: 2px solid var(--accent);
    color: var(--fg);
    font-family: var(--mono);
    font-size: var(--step--2);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.04em;
    line-height: 1.6;
    text-transform: uppercase;
    pointer-events: none;
  }

  .fallback {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    background: radial-gradient(circle, var(--line) 1px, transparent 1.5px) center / 1.5rem 1.5rem;
    transition: opacity var(--slow) var(--ease);
  }

  .edges {
    fill: none;
    stroke: var(--line);
  }

  .nodes {
    fill: var(--fg);
  }

  .packets {
    fill: var(--accent);
  }

  .pause {
    position: absolute;
    right: var(--inset);
    bottom: var(--margin);
    z-index: 1;
    min-height: 44px;
    padding-inline: 1rem;
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: 2px;
    color: var(--muted);

    &:hover {
      color: var(--fg);
    }

    &[hidden] {
      display: none;
    }
  }
</style>
