---
import { getRelativeLocaleUrl } from "astro:i18n";

import translations from "../i18n/translations";
import Layout from "../layouts/Layout.astro";

const t = translations(Astro.currentLocale);
---

<Layout title={t("Not found")} description={t("The page you asked for does not exist or has moved.")} noindex>
  <section class="grid">
    <p class="label muted">404</p>
    <h1>{t("Nothing at this address.")}</h1>
    <p class="body">{t("The page you asked for does not exist or has moved.")}</p>
    <a class="link" href={getRelativeLocaleUrl(Astro.currentLocale ?? "en")}>
      {t("Back to the home page")}
    </a>
  </section>
</Layout>

<style>
  section {
    align-content: center;
    row-gap: 1.5rem;
    min-height: calc(100svh - var(--header) - 12rem);
    padding-block: var(--section);

    > * {
      grid-column: 1 / -1;
    }
  }

  h1 {
    max-width: 16ch;
    font-size: var(--step-5);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .body {
    max-width: 40ch;
    color: var(--muted);
  }

  a {
    justify-self: start;
  }
</style>
