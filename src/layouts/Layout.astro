---
import "../styles/reset.css";
import "../styles/tokens.css";
import "../styles/base.css";

import { Font } from "astro:assets";
import { getRelativeLocaleUrl } from "astro:i18n";

import Footer from "../footer/Footer.astro";
import Header from "../header/Header.astro";
import region from "../i18n/region";
import translations from "../i18n/translations";
import profile from "../profile";
import palette from "../styles/palette";

type Props = {
  description: string;
  noindex?: boolean;
  schema?: Record<string, unknown>;
  title: string;
  type?: "article" | "website";
};

const t = translations(Astro.currentLocale);
const pathname = Astro.url.pathname.replace(/(?:\/index)?\.html$/, "") || "/";
const path = pathname.replace(/^\/es(?=\/|$)/, "") || "/";
const canonical = new URL(pathname, Astro.site).href;
const alternate = Astro.currentLocale === "es" ? "en" : "es";
const url = (code: string) => new URL(getRelativeLocaleUrl(code, path), Astro.site).href;
const switcher = {
  href: getRelativeLocaleUrl(alternate, path),
  locale: alternate,
  name: alternate === "es" ? "Español" : "English",
};
---

<!doctype html>
<html lang={Astro.currentLocale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{Astro.props.title}</title>
    <meta name="description" content={Astro.props.description} />
    {Astro.props.noindex ? (
      <meta name="robots" content="noindex" />
    ) : (
      <>
        <link rel="canonical" href={canonical} />
        <link rel="alternate" hreflang="en" href={url("en")} />
        <link rel="alternate" hreflang="es" href={url("es")} />
        <link rel="alternate" hreflang="x-default" href={url("en")} />
      </>
    )}
    <meta name="color-scheme" content="dark light" />
    <meta name="theme-color" content={palette.bg} media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content={palette.light.bg} media="(prefers-color-scheme: light)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta property="og:type" content={Astro.props.type ?? "website"} />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:title" content={Astro.props.title} />
    <meta property="og:description" content={Astro.props.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(`/og${pathname === "/" ? "/index" : pathname}.png`, Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={Astro.props.title} />
    <meta property="og:locale" content={region(Astro.currentLocale).replace("-", "_")} />
    <meta property="og:locale:alternate" content={region(alternate).replace("-", "_")} />
    <meta name="twitter:card" content="summary_large_image" />
    <Font cssVariable="--font-sans" preload />
    <Font cssVariable="--font-mono" />
    {Astro.props.schema && (
      <script
        is:inline
        type="application/ld+json"
        set:html={JSON.stringify({ "@context": "https://schema.org", ...Astro.props.schema }).replaceAll(
          "<",
          String.raw`\u003c`,
        )}
      ></script>
    )}
  </head>
  <body>
    <a class="skip" href="#main">
      {t("Skip to content")}
    </a>
    <Header alternate={switcher} />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  .skip {
    position: fixed;
    top: 0.5rem;
    left: 0.5rem;
    z-index: 100;
    padding: 0.75rem 1rem;
    background: var(--fg);
    color: var(--bg);
    font-weight: 500;
    transform: translateY(-200%);

    &:focus {
      transform: none;
    }

    @media print {
      display: none;
    }
  }
</style>
