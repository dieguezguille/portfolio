{
  "name": "portfolio",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": "^24.16.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "prepare": "git config core.hooksPath .githooks",
    "test": "pnpm test:ts && pnpm test:eslint && pnpm test:prettier && pnpm test:spell && pnpm test:vi && pnpm build && pnpm test:markdown && pnpm test:budget",
    "test:budget": "node scripts/budget.ts",
    "test:e2e": "playwright test",
    "test:eslint": "eslint --max-warnings 0 .",
    "test:lighthouse": "lhci autorun",
    "test:markdown": "markdownlint-cli2 '**/*.md' '#node_modules'",
    "test:prettier": "prettier --check .",
    "test:spell": "cspell --gitignore --no-progress '**'",
    "test:ts": "astro check",
    "test:vi": "vitest run"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.4",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@cspell/dict-es-es": "^3.0.8",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint/js": "^10.0.1",
    "@fontsource/geist": "^5.3.0",
    "@fontsource/geist-mono": "^5.3.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.63.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/three": "^0.186.0",
    "cspell": "^10.3.3",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-perfectionist": "^5.12.0",
    "eslint-plugin-regexp": "^3.3.1",
    "eslint-plugin-unicorn": "^76.0.0",
    "globals": "^17.12.0",
    "markdownlint-cli2": "^0.23.3",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.0.1",
    "satori": "^0.33.5",
    "sharp": "^0.35.4",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1",
    "wrangler": "~4.137.0",
    "yaml": "^2.9.1"
  }
}
